<% layout("/layout/boilerplate") %>
<body>
    <h3>All Listings</h3>
    <form method = "GET" action="/listings/new" >
        <button>Create new</button>
    </form>
    <ul>
    <!-- Each title opens its detail page -->
    <% for(let listing of allListings) { %>
        <li> <a href="/listings/<%= listing._id %>"><%= listing.title %></a></li>

    <% } %>
</ul>
    
</body>
</html>
